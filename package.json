{
  "name": "wolfx-project-site",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "pregenerate": "node scripts/generate-search-index.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck && tsc --noEmit -p worker/tsconfig.json",
    "lint": "eslint . --ignore-pattern worker-configuration.d.ts",
    "lint:fix": "eslint . --fix --ignore-pattern worker-configuration.d.ts",
    "content:migrate": "node scripts/migrate-legacy-content.mjs",
    "content:audit": "node scripts/audit-legacy-content.mjs",
    "search:generate": "node scripts/generate-search-index.mjs",
    "check": "node scripts/check-site.mjs",
    "test:e2e": "pnpm generate && playwright test --project=desktop-chromium --project=mobile-chromium",
    "test:e2e:mobile": "pnpm generate && playwright test tests/e2e/mobile.spec.mjs --project=mobile-chromium --project=mobile-webkit",
    "wrangler:types": "wrangler types worker-configuration.d.ts",
    "cf:prepare": "pnpm generate",
    "cf:dev": "pnpm generate && wrangler dev --port 8787",
    "cf:test": "node scripts/check-cloudflare.mjs",
    "nginx:test": "node scripts/check-nginx-static.mjs",
    "cf:dry-run": "pnpm generate && pnpm check && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "cf:deploy": "pnpm typecheck && pnpm lint && pnpm content:audit && pnpm generate && pnpm check && wrangler deploy"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.141",
    "@nuxt/content": "^3.16.1",
    "@nuxt/ui": "^4.11.3",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/sitemap": "^8.6.1",
    "nuxt": "^4.6.0",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "1.64.0",
    "@types/node": "^26.6.4",
    "better-sqlite3": "^13.0.3",
    "debug": "^4.4.3",
    "eslint": "^10.12.0",
    "extend": "^3.0.2",
    "oxc-parser": "^0.149.0",
    "parse5": "^8.0.1",
    "rehype-raw": "^7.0.0",
    "remark-emoji": "^5.0.2",
    "remark-gfm": "^4.0.1",
    "remark-mdc": "^3.11.1",
    "remark-rehype": "^11.1.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "unplugin": "^3.4.0",
    "vue-tsc": "^3.3.12",
    "wrangler": "4.148.0"
  }
}
